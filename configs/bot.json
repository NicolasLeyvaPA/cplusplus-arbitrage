{
  "mode": "paper",

  "exchange": {
    "api_key_env": "BINANCE_API_KEY",
    "api_secret_env": "BINANCE_API_SECRET",
    "testnet": true,
    "spot_rest_url": "https://testnet.binance.vision",
    "spot_ws_url": "wss://testnet.binance.vision/ws",
    "futures_rest_url": "https://testnet.binancefuture.com",
    "futures_ws_url": "wss://stream.binancefuture.com/ws",
    "reconnect_delay_ms": 1000,
    "max_reconnect_attempts": 10,
    "connection_timeout_ms": 10000
  },

  "strategy": {
    "symbols": ["BTCUSDT", "ETHUSDT"],
    "min_funding_rate": 0.0001,
    "min_annual_yield_pct": 10.0,
    "min_avg_funding_rate": 0.00005,
    "max_basis_deviation_pct": 0.5,
    "funding_rate_lookback_periods": 24,
    "entry_score_threshold": 0.7,
    "max_positions": 3,
    "rebalance_threshold_pct": 2.0,
    "max_holding_periods": 90
  },

  "risk": {
    "max_total_exposure_usd": 10000.0,
    "max_per_symbol_exposure_usd": 5000.0,
    "max_drawdown_pct": 5.0,
    "max_daily_loss_usd": 200.0,
    "futures_leverage": 1,
    "margin_type": "ISOLATED",
    "stop_loss_basis_bps": 100.0,
    "max_funding_rate_to_pay": -0.0001,
    "max_orders_per_minute": 10
  },

  "capital": {
    "starting_balance_usd": 1000.0,
    "allocation_pct": 80.0
  },

  "logging": {
    "log_dir": "./logs",
    "log_level": "info",
    "log_to_console": true,
    "log_to_file": true
  },

  "polling": {
    "funding_rate_interval_s": 60,
    "price_update_interval_ms": 1000,
    "strategy_eval_interval_s": 30,
    "hedge_check_interval_s": 10,
    "pnl_snapshot_interval_s": 300
  },

  "database_path": "./data/delta_neutral.db",
  "trade_ledger_path": "./data/trades.jsonl"
}
